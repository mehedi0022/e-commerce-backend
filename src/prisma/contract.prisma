// use prisma-8
enum AccountTokenType {
  @@type("pg/text@1")
  PASSWORD_RESET = "PASSWORD_RESET"
  EMAIL_VERIFICATION = "EMAIL_VERIFICATION"
}

enum ProductStatus {
  @@type("pg/text@1")
  DRAFT = "DRAFT"
  ACTIVE = "ACTIVE"
  INACTIVE = "INACTIVE"
  ARCHIVED = "ARCHIVED"
}

enum NavigationItemType {
  @@type("pg/text@1")
  LINK = "LINK"
  CATEGORY = "CATEGORY"
  MEGA_MENU = "MEGA_MENU"
}

enum NavigationEntryType {
  @@type("pg/text@1")
  LINK = "LINK"
  CATEGORY = "CATEGORY"
  PRODUCT = "PRODUCT"
}

enum PopupDisplayType {
  @@type("pg/text@1")
  ON_LOAD = "ON_LOAD"
  EXIT_INTENT = "EXIT_INTENT"
  AFTER_DELAY = "AFTER_DELAY"
}

enum PopupFrequency {
  @@type("pg/text@1")
  ONCE = "ONCE"
  DAILY = "DAILY"
  ALWAYS = "ALWAYS"
}

enum InventoryMovementType {
  @@type("pg/text@1")
  INITIAL_STOCK = "INITIAL_STOCK"
  RESTOCK = "RESTOCK"
  ORDER = "ORDER"
  ORDER_CANCELLED = "ORDER_CANCELLED"
  RETURN = "RETURN"
  DAMAGED = "DAMAGED"
  ADJUSTMENT = "ADJUSTMENT"
}

enum CartStatus {
  @@type("pg/text@1")
  ACTIVE = "ACTIVE"
  CONVERTED = "CONVERTED"
  ABANDONED = "ABANDONED"
}

enum OrderStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  CONFIRMED = "CONFIRMED"
  PROCESSING = "PROCESSING"
  SHIPPED = "SHIPPED"
  DELIVERED = "DELIVERED"
  CANCELLED = "CANCELLED"
}

enum OrderAddressType {
  @@type("pg/text@1")
  SHIPPING = "SHIPPING"
  BILLING = "BILLING"
}

enum OrderPaymentMethod {
  @@type("pg/text@1")
  CASH_ON_DELIVERY = "CASH_ON_DELIVERY"
  ONLINE = "ONLINE"
}

enum OrderPaymentStatus {
  @@type("pg/text@1")
  UNPAID = "UNPAID"
  PENDING = "PENDING"
  PAID = "PAID"
  FAILED = "FAILED"
  REFUNDED = "REFUNDED"
}

enum CouponDiscountType {
  @@type("pg/text@1")
  PERCENTAGE = "PERCENTAGE"
  FIXED_AMOUNT = "FIXED_AMOUNT"
}

enum ShipmentStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  READY_TO_SHIP = "READY_TO_SHIP"
  SHIPPED = "SHIPPED"
  IN_TRANSIT = "IN_TRANSIT"
  OUT_FOR_DELIVERY = "OUT_FOR_DELIVERY"
  DELIVERED = "DELIVERED"
  FAILED = "FAILED"
  RETURNED = "RETURNED"
  CANCELLED = "CANCELLED"
}

enum ReturnStatus {
  @@type("pg/text@1")
  REQUESTED = "REQUESTED"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
  IN_TRANSIT = "IN_TRANSIT"
  RECEIVED = "RECEIVED"
  COMPLETED = "COMPLETED"
  CANCELLED = "CANCELLED"
}

enum ReturnReason {
  @@type("pg/text@1")
  DAMAGED = "DAMAGED"
  DEFECTIVE = "DEFECTIVE"
  WRONG_ITEM = "WRONG_ITEM"
  NOT_AS_DESCRIBED = "NOT_AS_DESCRIBED"
  SIZE_OR_FIT = "SIZE_OR_FIT"
  CHANGED_MIND = "CHANGED_MIND"
  OTHER = "OTHER"
}

enum ReturnItemCondition {
  @@type("pg/text@1")
  UNOPENED = "UNOPENED"
  GOOD = "GOOD"
  DAMAGED = "DAMAGED"
  DEFECTIVE = "DEFECTIVE"
  USED = "USED"
}

enum ReturnItemRestockStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  RESTOCKED = "RESTOCKED"
  NOT_RESTOCKABLE = "NOT_RESTOCKABLE"
}

enum RefundStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  PROCESSING = "PROCESSING"
  COMPLETED = "COMPLETED"
  FAILED = "FAILED"
  CANCELLED = "CANCELLED"
}

enum RefundMethod {
  @@type("pg/text@1")
  CASH = "CASH"
  BANK_TRANSFER = "BANK_TRANSFER"
  MOBILE_BANKING = "MOBILE_BANKING"
  ORIGINAL_PAYMENT_METHOD = "ORIGINAL_PAYMENT_METHOD"
  OTHER = "OTHER"
}

enum ProductReviewStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
}

// Database-driven RBAC foundation. `User.role` remains temporarily during the
// expand/backfill rollout; `rbacRole` becomes the authorization source once
// existing users have been migrated.
model Role {
  id              Int                  @id @default(autoincrement())
  key             String               @unique
  name            String               @unique
  rank            Int                  @unique
  isSystem        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       temporal.updatedAt()
  users           User[]
  rolePermissions RolePermission[]

  @@index([rank])
  @@map("role")
}

model Permission {
  id              Int                  @id @default(autoincrement())
  key             String               @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime             @default(now())
  updatedAt       temporal.updatedAt()
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permission")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields:[roleId], references:[id], onDelete: Cascade)
  permission   Permission @relation(fields:[permissionId], references:[id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("rolePermission")
}

model User {
  id                      Int                     @id @default(autoincrement())
  email                   String                  @unique
  userName                String?
  fullName                String?
  password                String
  createdAt               DateTime                @default(now())
  updatedAt               temporal.updatedAt()
  roleId                  Int
  rbacRole                Role                    @relation(fields:[roleId], references:[id], onDelete: Restrict)
  isActive                Boolean                 @default(true)
  emailVerifiedAt         DateTime?

  sessions                Session[]
  accountTokens           AccountToken[]
  carts                   Cart[]
  addresses               Address[]
  orders                  Order[]
  couponUsages            CouponUsage[]
  changedOrderStatuses    OrderStatusHistory[]    @relation("OrderStatusChangedBy")
  shipmentStatusChanges   ShipmentStatusHistory[] @relation("ShipmentStatusChangedBy")

  returns                 Return[]

  returnStatusChanges     ReturnStatusHistory[]   @relation("ReturnStatusChangedBy")

  processedRefunds        Refund[]                @relation("RefundProcessedBy")

  refundStatusChanges     RefundStatusHistory[]   @relation("RefundStatusChangedBy")

  productReviews          ProductReview[]         @relation("ProductReviewUser")

  moderatedProductReviews ProductReview[]         @relation("ProductReviewModerator")

  wishlistItems           WishlistItem[]

  @@index([roleId])
  @@map("user")
}

model Session {
  id                Int       @id @default(autoincrement())
  userId            Int
  jti               String    @unique @default(uuid())
  familyId          String    @default(uuid())
  refreshTokenHash  String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  consumedAt        DateTime?
  replacedByJti     String?
  absoluteExpiresAt DateTime
  rememberMe        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  user              User      @relation(fields:[userId], references:[id])

  @@index([userId])
  @@index([familyId])
  @@map("session")
}

model AccountToken {
  id         Int              @id @default(autoincrement())
  userId     Int
  type       AccountTokenType
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user       User             @relation(fields:[userId], references:[id])

  @@index([userId, type])
  @@index([expiresAt])
  @@map("accountToken")
}

model Category {
  id                Int                  @id @default(autoincrement())
  name              String               @unique
  slug              String               @unique
  description       String?
  image             String?
  parentId          Int?

  parent            Category?            @relation("CategoryHierarchy", fields:[parentId], references:[id], onDelete: SetNull)
  children          Category[]           @relation("CategoryHierarchy")

  products          ProductCategory[]
  navigationItems   NavigationItem[]
  navigationEntries NavigationEntry[]

  isActive          Boolean              @default(true)
  sortOrder         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         temporal.updatedAt()

  @@map("category")
}

model Brand {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  slug        String               @unique
  logo        String?
  description String?
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()

  products    Product[]

  @@map("brand")
}

model Attribute {
  id         Int                  @id @default(autoincrement())
  name       String               @unique
  slug       String               @unique

  isActive   Boolean              @default(true)
  sortOrder  Int                  @default(0)

  createdAt  DateTime             @default(now())
  updatedAt  temporal.updatedAt()

  values     AttributeValue[]
  categories CategoryAttribute[]

  @@index([isActive, sortOrder])
  @@map("attribute")
}

model AttributeValue {
  id            Int                          @id @default(autoincrement())
  attributeId   Int
  value         String
  slug          String
  sortOrder     Int                          @default(0)
  isActive      Boolean                      @default(true)

  createdAt     DateTime                     @default(now())
  updatedAt     temporal.updatedAt()

  attribute     Attribute                    @relation(fields:[attributeId], references:[id], onDelete: Cascade)

  variants      VariantAttributeValue[]
  productImages ProductImageAttributeValue[]

  @@unique([attributeId, value])
  @@unique([attributeId, slug])
  @@index([attributeId, isActive, sortOrder])
  @@map("attribute_value")
}

model CategoryAttribute {
  id          Int                  @id @default(autoincrement())
  categoryId  Int
  attributeId Int

  isRequired  Boolean              @default(false)
  sortOrder   Int                  @default(0)

  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()

  category    Category             @relation(fields:[categoryId], references:[id], onDelete: Cascade)

  attribute   Attribute            @relation(fields:[attributeId], references:[id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([categoryId, sortOrder])
  @@index([attributeId])
  @@map("category_attribute")
}

model Product {
  id                Int                  @id @default(autoincrement())
  name              String
  slug              String               @unique
  shortDescription  String?
  description       String?

  brandId           Int?
  brand             Brand?               @relation(fields:[brandId], references:[id], onDelete: SetNull)

  status            ProductStatus        @default(DRAFT)
  isFeatured        Boolean              @default(false)

  createdAt         DateTime             @default(now())
  updatedAt         temporal.updatedAt()

  categories        ProductCategory[]
  variants          ProductVariant[]
  images            ProductImage[]
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]
  navigationEntries NavigationEntry[]

  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@map("product")
}

model ProductCategory {
  productId  Int
  categoryId Int
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)

  product    Product  @relation(fields:[productId], references:[id], onDelete: Cascade)

  category   Category @relation(fields:[categoryId], references:[id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId, isPrimary])
  @@map("product_category")
}

model ProductVariant {
  id              Int                     @id @default(autoincrement())
  productId       Int
  sku             String                  @unique

  price           Numeric(12, 2)
  compareAtPrice  Numeric(12, 2)?
  costPrice       Numeric(12, 2)?

  isActive        Boolean                 @default(true)
  sortOrder       Int                     @default(0)

  product         Product                 @relation(fields:[productId], references:[id], onDelete: Cascade)

  attributeValues VariantAttributeValue[]
  inventory       Inventory?

  createdAt       DateTime                @default(now())
  updatedAt       temporal.updatedAt()

  cartItems       CartItem[]

  @@index([productId, isActive])
  @@map("product_variant")
}

model VariantAttributeValue {
  variantId        Int
  attributeValueId Int

  variant          ProductVariant @relation(fields:[variantId], references:[id], onDelete: Cascade)

  attributeValue   AttributeValue @relation(fields:[attributeValueId], references:[id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_value")
}

model Inventory {
  id                Int                  @id @default(autoincrement())
  variantId         Int                  @unique

  quantity          Int                  @default(0)
  reservedQuantity  Int                  @default(0)
  lowStockThreshold Int                  @default(5)

  variant           ProductVariant       @relation(fields:[variantId], references:[id], onDelete: Cascade)

  movements         InventoryMovement[]

  createdAt         DateTime             @default(now())
  updatedAt         temporal.updatedAt()

  @@map("inventory")
}

model InventoryMovement {
  id            Int                   @id @default(autoincrement())
  inventoryId   Int

  type          InventoryMovementType
  quantity      Int

  referenceType String?
  referenceId   String?
  note          String?

  inventory     Inventory             @relation(fields:[inventoryId], references:[id], onDelete: Cascade)

  createdAt     DateTime              @default(now())

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movement")
}

model ProductImage {
  id              Int                          @id @default(autoincrement())
  productId       Int

  imageUrl        String
  storageKey      String?
  altText         String?

  isPrimary       Boolean                      @default(false)
  sortOrder       Int                          @default(0)

  product         Product                      @relation(fields:[productId], references:[id], onDelete: Cascade)

  attributeValues ProductImageAttributeValue[]

  createdAt       DateTime                     @default(now())
  updatedAt       temporal.updatedAt()

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_image")
}

model ProductImageAttributeValue {
  productImageId   Int
  attributeValueId Int

  productImage     ProductImage   @relation(fields:[productImageId], references:[id], onDelete: Cascade)

  attributeValue   AttributeValue @relation(fields:[attributeValueId], references:[id], onDelete: Cascade)

  @@id([productImageId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_image_attribute_value")
}

model NavigationMenu {
  id        Int                  @id @default(autoincrement())
  name      String
  key       String               @unique
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  items     NavigationItem[]

  @@index([isActive])
  @@map("navigation_menu")
}

model NavigationItem {
  id         Int                  @id @default(autoincrement())
  menuId     Int
  label      String
  type       NavigationItemType
  url        String?
  categoryId Int?
  sortOrder  Int                  @default(0)
  isActive   Boolean              @default(true)
  openNewTab Boolean              @default(false)
  createdAt  DateTime             @default(now())
  updatedAt  temporal.updatedAt()

  menu       NavigationMenu       @relation(fields:[menuId], references:[id], onDelete: Cascade)
  category   Category?            @relation(fields:[categoryId], references:[id], onDelete: SetNull)
  sections   NavigationSection[]

  @@index([menuId, sortOrder])
  @@index([categoryId])
  @@map("navigation_item")
}

model NavigationSection {
  id        Int                  @id @default(autoincrement())
  itemId    Int
  title     String
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  item      NavigationItem       @relation(fields:[itemId], references:[id], onDelete: Cascade)
  entries   NavigationEntry[]

  @@index([itemId, sortOrder])
  @@map("navigation_section")
}

model NavigationEntry {
  id         Int                  @id @default(autoincrement())
  sectionId  Int
  label      String
  type       NavigationEntryType
  url        String?
  categoryId Int?
  productId  Int?
  sortOrder  Int                  @default(0)
  isActive   Boolean              @default(true)
  openNewTab Boolean              @default(false)
  createdAt  DateTime             @default(now())
  updatedAt  temporal.updatedAt()

  section    NavigationSection    @relation(fields:[sectionId], references:[id], onDelete: Cascade)
  category   Category?            @relation(fields:[categoryId], references:[id], onDelete: SetNull)
  product    Product?             @relation(fields:[productId], references:[id], onDelete: SetNull)

  @@index([sectionId, sortOrder])
  @@index([categoryId])
  @@index([productId])
  @@map("navigation_entry")
}

model Slider {
  id          Int                  @id @default(autoincrement())
  title       String
  subtitle    String?
  imageUrl    String?
  storageKey  String?
  mobileImage String?
  mobileKey   String?
  buttonText  String?
  buttonUrl   String?
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()

  @@index([isActive, sortOrder])
  @@index([startsAt, endsAt])
  @@map("slider")
}

model Popup {
  id           Int                  @id @default(autoincrement())
  title        String
  description  String?
  imageUrl     String?
  storageKey   String?
  buttonText   String?
  buttonUrl    String?
  displayType  PopupDisplayType     @default(ON_LOAD)
  delaySeconds Int                  @default(0)
  frequency    PopupFrequency       @default(ONCE)
  isActive     Boolean              @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    temporal.updatedAt()

  @@index([isActive, startsAt, endsAt])
  @@map("popup")
}

model Cart {
  id         Int                  @id @default(autoincrement())
  userId     Int?
  guestToken String?              @unique
  status     CartStatus           @default(ACTIVE)

  expiresAt  DateTime?

  user       User?                @relation(fields:[userId], references:[id], onDelete: Cascade)
  items      CartItem[]

  createdAt  DateTime             @default(now())
  updatedAt  temporal.updatedAt()

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("cart")
}

model CartItem {
  id        Int                  @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int                  @default(1)

  cart      Cart                 @relation(fields:[cartId], references:[id], onDelete: Cascade)

  variant   ProductVariant       @relation(fields:[variantId], references:[id], onDelete: Cascade)

  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_item")
}

model Address {
  id                Int                  @id @default(autoincrement())
  userId            Int

  label             String?
  fullName          String
  phone             String

  addressLine1      String
  addressLine2      String?

  division          String?
  district          String
  upazila           String?
  thana             String?
  area              String?
  postalCode        String?

  countryCode       String               @default("BD")

  isDefaultShipping Boolean              @default(false)
  isDefaultBilling  Boolean              @default(false)

  user              User                 @relation(fields:[userId], references:[id], onDelete: Cascade)

  createdAt         DateTime             @default(now())
  updatedAt         temporal.updatedAt()

  @@index([userId])
  @@index([userId, isDefaultShipping])
  @@index([userId, isDefaultBilling])
  @@index([countryCode, district])
  @@map("address")
}

model ShippingZone {
  id          Int                  @id @default(autoincrement())
  name        String
  description String?

  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)

  areas       ShippingZoneArea[]
  methods     ShippingZoneMethod[]

  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()

  @@index([isActive, sortOrder])
  @@map("shipping_zone")
}

model ShippingZoneArea {
  id          Int                  @id @default(autoincrement())
  zoneId      Int

  countryCode String               @default("BD")

  division    String?
  district    String?
  upazila     String?
  thana       String?
  area        String?

  postalCode  String?

  zone        ShippingZone         @relation(fields:[zoneId], references:[id], onDelete: Cascade)

  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()

  @@index([zoneId])
  @@index([countryCode, district])
  @@index([district, thana])
  @@index([district, upazila])
  @@map("shipping_zone_area")
}

model ShippingMethod {
  id          Int                  @id @default(autoincrement())
  name        String
  code        String               @unique
  description String?

  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)

  zoneMethods ShippingZoneMethod[]

  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()

  @@index([isActive, sortOrder])
  @@map("shipping_method")
}

model ShippingZoneMethod {
  id               Int                  @id @default(autoincrement())
  zoneId           Int
  methodId         Int

  charge           Numeric(12, 2)

  estimatedMinDays Int?
  estimatedMaxDays Int?

  isActive         Boolean              @default(true)
  sortOrder        Int                  @default(0)

  zone             ShippingZone         @relation(fields:[zoneId], references:[id], onDelete: Cascade)

  method           ShippingMethod       @relation(fields:[methodId], references:[id], onDelete: Cascade)

  createdAt        DateTime             @default(now())
  updatedAt        temporal.updatedAt()

  @@unique([zoneId, methodId])
  @@index([zoneId, isActive])
  @@index([methodId])
  @@map("shipping_zone_method")
}

model Order {
  id                        Int                  @id @default(autoincrement())
  orderNumber               String               @unique
  guestAccessTokenHash      String?              @unique
  guestAccessTokenExpiresAt DateTime?

  // Nullable because guest checkout is supported
  userId                    Int?

  // Customer snapshot
  customerName              String
  customerEmail             String?
  customerPhone             String

  status                    OrderStatus          @default(PENDING)
  paymentMethod             OrderPaymentMethod
  paymentStatus             OrderPaymentStatus   @default(UNPAID)

  couponId                  Int?
  couponCode                String?

  // Financial snapshot
  subtotal                  Numeric(12, 2)
  shippingCharge            Numeric(12, 2)
  discountAmount            Numeric(12, 2)       @default(0)
  taxAmount                 Numeric(12, 2)       @default(0)
  grandTotal                Numeric(12, 2)

  coupon                    Coupon?              @relation(fields:[couponId], references:[id], onDelete: SetNull)
  couponUsages              CouponUsage[]
  shipment                  Shipment?

  // Optional live references
  shippingZoneId            Int?
  shippingMethodId          Int?

  // Historical snapshots
  shippingZoneName          String?
  shippingMethodName        String?

  customerNote              String?
  adminNote                 String?

  placedAt                  DateTime             @default(now())
  confirmedAt               DateTime?
  shippedAt                 DateTime?
  deliveredAt               DateTime?
  cancelledAt               DateTime?

  user                      User?                @relation(fields:[userId], references:[id], onDelete: SetNull)

  shippingZone              ShippingZone?        @relation(fields:[shippingZoneId], references:[id], onDelete: SetNull)

  shippingMethod            ShippingMethod?      @relation(fields:[shippingMethodId], references:[id], onDelete: SetNull)

  items                     OrderItem[]
  addresses                 OrderAddress[]
  statusHistory             OrderStatusHistory[]
  returns                   Return[]
  refunds                   Refund[]

  createdAt                 DateTime             @default(now())
  updatedAt                 temporal.updatedAt()

  @@index([couponId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([createdAt])
  @@map("order")
}

model OrderItem {
  id          Int                  @id @default(autoincrement())
  orderId     Int
  productId   Int?
  variantId   Int?
  productName String
  productSlug String?
  sku         String
  quantity    Int
  unitPrice   Numeric(12, 2)
  lineTotal   Numeric(12, 2)
  order       Order                @relation(fields:[orderId], references:[id], onDelete: Cascade)
  product     Product?             @relation(fields:[productId], references:[id], onDelete: SetNull)
  variant     ProductVariant?      @relation(fields:[variantId], references:[id], onDelete: SetNull)
  attributes  OrderItemAttribute[]
  createdAt   DateTime             @default(now())

  returnItems ReturnItem[]
  review      ProductReview?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_item")
}

model OrderItemAttribute {
  id             Int       @id @default(autoincrement())
  orderItemId    Int

  attributeName  String
  attributeValue String

  orderItem      OrderItem @relation(fields:[orderItemId], references:[id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_attribute")
}

model OrderAddress {
  id           Int              @id @default(autoincrement())
  orderId      Int

  type         OrderAddressType

  fullName     String
  phone        String

  addressLine1 String
  addressLine2 String?

  division     String?
  district     String
  upazila      String?
  thana        String?
  area         String?
  postalCode   String?

  countryCode  String

  order        Order            @relation(fields:[orderId], references:[id], onDelete: Cascade)

  createdAt    DateTime         @default(now())

  @@unique([orderId, type])
  @@index([orderId])
  @@map("order_address")
}

model OrderStatusHistory {
  id          Int          @id @default(autoincrement())
  orderId     Int

  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById Int?
  order       Order        @relation(fields:[orderId], references:[id], onDelete: Cascade)
  changedBy   User?        @relation("OrderStatusChangedBy", fields:[changedById], references:[id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
  @@index([changedById])
  @@map("order_status_history")
}

model Coupon {
  id                    Int                  @id @default(autoincrement())

  code                  String               @unique

  name                  String
  description           String?

  discountType          CouponDiscountType
  discountValue         Numeric(12, 2)

  minimumOrderAmount    Numeric(12, 2)?
  maximumDiscountAmount Numeric(12, 2)?

  usageLimit            Int?
  usageLimitPerUser     Int?

  startsAt              DateTime?
  expiresAt             DateTime?

  isActive              Boolean              @default(true)

  usages                CouponUsage[]
  orders                Order[]

  createdAt             DateTime             @default(now())
  updatedAt             temporal.updatedAt()

  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
  @@map("coupon")
}

model CouponUsage {
  id       Int      @id @default(autoincrement())

  couponId Int
  orderId  Int
  userId   Int?

  coupon   Coupon   @relation(fields:[couponId], references:[id], onDelete: Restrict)

  order    Order    @relation(fields:[orderId], references:[id], onDelete: Cascade)

  user     User?    @relation(fields:[userId], references:[id], onDelete: SetNull)

  usedAt   DateTime @default(now())

  @@unique([couponId, orderId])

  @@index([couponId, usedAt])
  @@index([userId, couponId])
  @@index([orderId])

  @@map("coupon_usage")
}

model Shipment {
  id             Int                     @id @default(autoincrement())

  orderId        Int                     @unique

  status         ShipmentStatus          @default(PENDING)

  courierName    String?
  trackingNumber String?
  trackingUrl    String?

  note           String?

  readyAt        DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  returnedAt     DateTime?
  cancelledAt    DateTime?

  order          Order                   @relation(fields:[orderId], references:[id], onDelete: Cascade)

  statusHistory  ShipmentStatusHistory[]

  createdAt      DateTime                @default(now())
  updatedAt      temporal.updatedAt()

  @@index([status])
  @@index([trackingNumber])
  @@index([createdAt])

  @@map("shipment")
}

model ShipmentStatusHistory {
  id          Int             @id @default(autoincrement())

  shipmentId  Int

  fromStatus  ShipmentStatus?
  toStatus    ShipmentStatus

  note        String?

  changedById Int?

  shipment    Shipment        @relation(fields:[shipmentId], references:[id], onDelete: Cascade)

  changedBy   User?           @relation("ShipmentStatusChangedBy", fields:[changedById], references:[id], onDelete: SetNull)

  createdAt   DateTime        @default(now())

  @@index([shipmentId, createdAt])
  @@index([changedById])

  @@map("shipment_status_history")
}

model Return {
  id            Int                   @id @default(autoincrement())

  returnNumber  String                @unique

  orderId       Int
  userId        Int?

  status        ReturnStatus          @default(REQUESTED)

  customerNote  String?
  adminNote     String?

  requestedAt   DateTime              @default(now())
  approvedAt    DateTime?
  rejectedAt    DateTime?
  receivedAt    DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  order         Order                 @relation(fields:[orderId], references:[id], onDelete: Restrict)

  user          User?                 @relation(fields:[userId], references:[id], onDelete: SetNull)

  items         ReturnItem[]
  statusHistory ReturnStatusHistory[]
  refunds       Refund[]

  createdAt     DateTime              @default(now())
  updatedAt     temporal.updatedAt()

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])

  @@map("return")
}

model ReturnItem {
  id              Int                     @id @default(autoincrement())

  returnId        Int
  orderItemId     Int

  quantity        Int

  reason          ReturnReason

  customerNote    String?
  adminNote       String?

  condition       ReturnItemCondition?

  restockStatus   ReturnItemRestockStatus @default(PENDING)
  restockQuantity Int                     @default(0)

  return          Return                  @relation(fields:[returnId], references:[id], onDelete: Cascade)

  orderItem       OrderItem               @relation(fields:[orderItemId], references:[id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])

  @@map("return_item")
}

model ReturnStatusHistory {
  id          Int           @id @default(autoincrement())

  returnId    Int

  fromStatus  ReturnStatus?
  toStatus    ReturnStatus

  note        String?

  changedById Int?

  return      Return        @relation(fields:[returnId], references:[id], onDelete: Cascade)

  changedBy   User?         @relation("ReturnStatusChangedBy", fields:[changedById], references:[id], onDelete: SetNull)

  createdAt   DateTime      @default(now())

  @@index([returnId, createdAt])
  @@index([changedById])

  @@map("return_status_history")
}

model Refund {
  id            Int                   @id @default(autoincrement())

  refundNumber  String                @unique

  orderId       Int
  returnId      Int?

  amount        Numeric(12, 2)

  status        RefundStatus          @default(PENDING)
  method        RefundMethod?

  reason        String?
  note          String?

  processedById Int?

  processedAt   DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  cancelledAt   DateTime?

  order         Order                 @relation(fields:[orderId], references:[id], onDelete: Restrict)

  return        Return?               @relation(fields:[returnId], references:[id], onDelete: SetNull)

  processedBy   User?                 @relation("RefundProcessedBy", fields:[processedById], references:[id], onDelete: SetNull)

  statusHistory RefundStatusHistory[]

  createdAt     DateTime              @default(now())
  updatedAt     temporal.updatedAt()

  @@index([orderId])
  @@index([returnId])
  @@index([status])
  @@index([createdAt])

  @@map("refund")
}

model RefundStatusHistory {
  id          Int           @id @default(autoincrement())

  refundId    Int

  fromStatus  RefundStatus?
  toStatus    RefundStatus

  note        String?

  changedById Int?

  refund      Refund        @relation(fields:[refundId], references:[id], onDelete: Cascade)

  changedBy   User?         @relation("RefundStatusChangedBy", fields:[changedById], references:[id], onDelete: SetNull)

  createdAt   DateTime      @default(now())

  @@index([refundId, createdAt])
  @@index([changedById])

  @@map("refund_status_history")
}

model ProductReview {
  id                 Int                  @id @default(autoincrement())

  productId          Int
  userId             Int
  orderItemId        Int

  rating             Int

  title              String?
  comment            String?

  status             ProductReviewStatus  @default(PENDING)

  isVerifiedPurchase Boolean              @default(true)

  approvedAt         DateTime?
  rejectedAt         DateTime?

  moderatedById      Int?

  product            Product              @relation(fields:[productId], references:[id], onDelete: Cascade)

  user               User                 @relation("ProductReviewUser", fields:[userId], references:[id], onDelete: Cascade)

  orderItem          OrderItem            @relation(fields:[orderItemId], references:[id], onDelete: Restrict)

  moderatedBy        User?                @relation("ProductReviewModerator", fields:[moderatedById], references:[id], onDelete: SetNull)

  createdAt          DateTime             @default(now())
  updatedAt          temporal.updatedAt()

  @@unique([orderItemId])
  @@unique([userId, productId])

  @@index([productId, status])
  @@index([productId, rating])
  @@index([userId])
  @@index([status])
  @@index([createdAt])

  @@map("product_review")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())

  userId    Int
  productId Int

  user      User     @relation(fields:[userId], references:[id], onDelete: Cascade)

  product   Product  @relation(fields:[productId], references:[id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])

  @@index([userId, createdAt])
  @@index([productId])

  @@map("wishlist_item")
}
