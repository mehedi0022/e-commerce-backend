      {
        "description": "create table \"order_payment_transaction\"",
        "sql": "CREATE TABLE \"public\".\"order_payment_transaction\" (\n  \"adminNote\" text,\n  \"amount\" numeric(12,2) NOT NULL,\n  \"bankTransferReference\" text,\n  \"chargeAmount\" numeric(12,2) DEFAULT '0'::numeric(12,2) NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"gatewayPayload\" json,\n  \"gatewayResponse\" json,\n  \"id\" SERIAL NOT NULL,\n  \"orderId\" int4 NOT NULL,\n  \"paymentMethodCode\" text NOT NULL,\n  \"paymentMethodConfigId\" int4,\n  \"receiptImageUrl\" text,\n  \"senderNumber\" text,\n  \"status\" text DEFAULT 'PENDING_VERIFICATION' NOT NULL,\n  \"transactionId\" text,\n  \"type\" text DEFAULT 'MANUAL_MFS' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"verifiedAt\" timestamptz,\n  \"verifiedByUserId\" int4,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"order_payment_transaction_status_check_da7d3c1b\" CHECK (\"status\" IN ('PENDING_VERIFICATION', 'VERIFIED', 'REJECTED', 'REFUNDED')),\n  CONSTRAINT \"order_payment_transaction_type_check_1f7143c2\" CHECK (\"type\" IN ('COD', 'MANUAL_MFS', 'MANUAL_BANK', 'AUTOMATED_GATEWAY'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"order_payment_transaction\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"order_payment_transaction\""
        ]
      }
    ]
