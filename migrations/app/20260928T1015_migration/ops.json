        "description": "create table \"shipment\"",
        "sql": "CREATE TABLE \"public\".\"shipment\" (\n  \"cancelledAt\" timestamptz,\n  \"courierName\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"deliveredAt\" timestamptz,\n  \"failedAt\" timestamptz,\n  \"id\" SERIAL NOT NULL,\n  \"note\" text,\n  \"orderId\" int4 NOT NULL,\n  \"readyAt\" timestamptz,\n  \"returnedAt\" timestamptz,\n  \"shippedAt\" timestamptz,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"trackingNumber\" text,\n  \"trackingUrl\" text,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"shipment_status_check_806dcd4d\" CHECK (\"status\" IN ('PENDING', 'READY_TO_SHIP', 'SHIPPED', 'IN_TRANSIT', 'OUT_FOR_DELIVERY', 'DELIVERED', 'FAILED', 'RETURNED', 'CANCELLED'))\n)",
        "params": []
      }
    ],
